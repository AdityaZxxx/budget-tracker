{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      "side_effect_style",
      "side_effect",
      "type-import",
      ["value-builtin", "value-external"],
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "app/globals.css",
    "functions": ["cn"]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "packages/sora-lint-plugin/rules/**",
    "packages/sora-lint-plugin/shared/**"
  ]
}
