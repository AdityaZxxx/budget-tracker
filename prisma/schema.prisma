// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core models (user IDs are referenced by the app tables through
// HouseholdMembership.userId and Transaction.addedById, migrated from Clerk
// with their original IDs preserved)
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  memberships       HouseholdMembership[]
  addedTransactions Transaction[]
  createdInviteLinks InviteLink[]
  notifications     Notification[]
  transactionShares TransactionShare[]
}

model Household {
  id        String   @id @default(uuid())
  // Display name for the switcher; null for the household a user got by
  // default before households could be named.
  name      String?
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  HouseholdMembership[]
  inviteLinks  InviteLink[]
  transactions Transaction[]
  categories   Category[]
  goals        Goal[]
  budgets      Budget[]
  notifications Notification[]
  monthHistory MonthHistory[]
  yearHistory  YearHistory[]
}

model HouseholdMembership {
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  // Opt-in to the daily email digest of unread household notifications.
  emailDigest Boolean   @default(false)
  // "member" can change everything; "view_only" can only read. There is
  // still no owner role — full members all have equal rights.
  role        String    @default("member")

  @@id([householdId, userId])
}

model InviteLink {
  id          String    @id @default(uuid())
  token       String    @unique
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Better Auth rate limiting with storage: "database"
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Category {
  createdAt DateTime @default(now())
  name String
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  icon String
  type String @default("income")

  @@unique([name, householdId, type])
}

model Transaction {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  amount Float
  description String
  date DateTime
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  addedById String
  addedBy User @relation(fields: [addedById], references: [id], onDelete: Cascade)
  type String @default("income")

  // false = personal: visible only to addedById, excluded from household
  // totals, budgets, and history rollups (settlements are personal too)
  shared Boolean @default(true)

  category String
  categoryIcon String

  // Tags the transaction as a contribution to a goal; contributions are
  // normal transactions, so they still count toward spending stats.
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  shares TransactionShare[]
}

// One member's share of one shared expense. The member who added the
// transaction fronts the money; every member owes their share back to them.
// A transaction with no share rows is split evenly across the members at
// balance time; rows always sum to the transaction amount.
model TransactionShare {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float

  @@id([transactionId, userId])
}

model Goal {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  target      Float
  deadline    DateTime?
  createdAt   DateTime  @default(now())

  transactions Transaction[]
}

model MonthHistory {
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  day Int
  month Int
  year Int
  income Float
  expense Float

  @@id([day, month, year, householdId])
}

model YearHistory {
  householdId String
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  month Int
  year Int
  income Float
  expense Float

  @@id([month, year, householdId])
}

// Monthly spending limit on one category. "soft" warns at 80%/100% via
// notifications; "hard" rejects shared expense transactions over the limit.
model Budget {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  mode        String    @default("soft")
  createdAt   DateTime  @default(now())

  @@unique([householdId, category])
}

// In-app bell entry for one member; userId is the recipient.
model Notification {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}
