{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "unicorn",
    "react",
    "jsx-a11y",
    "nextjs",
    "import",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.3"
    }
  },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "next-env.d.ts",
    "packages/sora-lint-plugin/**"
  ],
  "jsPlugins": ["./packages/sora-lint-plugin/index.ts"],
  "rules": {
    // The project compiles JSX with the automatic runtime ("jsx": "react-jsx"),
    // so React no longer needs to be in scope.
    "react/react-in-jsx-scope": "off",

    "sora/no-em-dash-copy": "error",
    "sora/no-hookless-use-function": "error",
    "sora/no-low-value-comments": "error",
    "sora/no-manual-memo": "error",
    "sora/no-unscoped-has": "error",
    "sora/require-suppression-reason": "error",
    "sora/no-array-filter-map": "error",
    "sora/no-chained-type-assertions": "error",
    "sora/no-conditional-empty-object-spread": "error",
    "sora/no-module-mocking": "error",
    "sora/no-object-parameters": "error",
    "sora/no-reduce-accumulator-copy": "error",
    "sora/no-reflect-apply": "error",
    "sora/no-reflect-get": "error",
    "sora/no-shape-in-symbol-names": "error",
    "sora/no-unknown-parameters": "error",
    "sora/no-unknown-returns": "error",
    "sora/no-unknown-type-aliases": "error",
    "sora/no-unsafe-dictionary-type": "error",
    "sora/no-widen-then-assert": "error",

    // Prisma's aggregate API names its result field with a leading underscore.
    "eslint/no-underscore-dangle": ["error", { "allow": ["_sum"] }],

    // Side-effect imports are the point: the stylesheet and the dotenv
    // loader are imported for what they do, not for what they export.
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "dotenv/config"] }
    ],

    // The rule wants the context value wrapped in useMemo so it keeps a
    // stable identity across renders. The React Compiler does that itself,
    // and it allocates a cache slot for every context value in the repo.
    // Keeping the manual memo would duplicate the compiler's own cache.
    "react/jsx-no-constructed-context-values": "off",

    // The rule asks for Object.assign, which mutates the source row. These
    // arrays are server-owned and their consumers expect immutable objects.
    "oxc/no-map-spread": "off",

    // The rule prefers a native element, but the roles left in the codebase
    // are the ARIA-recommended pattern rather than an element substitute:
    // role="group" on a field and on a carousel slide group, role="region"
    // on the carousel, role="status" on a live region, role="separator"
    // between form controls, and role="combobox" on a picker trigger.
    "jsx-a11y/prefer-tag-over-role": "off",

    // React Compiler guardrail. CI runs these before the compiler is
    // enabled, so a Rules of React bailout is caught the day it is written.
    "react/immutability": "error",
    "react/refs": "error",
    "react/globals": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/set-state-in-effect": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-direct-mutation-state": "error",
    "react/static-components": "error",
    "react/no-unstable-nested-components": "error",
    "react/hooks": "error",
    "react/exhaustive-deps": "error",
    "react/exhaustive-effect-dependencies": "error",
    "react/memo-dependencies": "error",
    "react/preserve-manual-memoization": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/invariant": "error",
    "react/unsupported-syntax": "error",
    "react/incompatible-library": "error",
    "react/error-boundaries": "error"
  },
  "overrides": [
    {
      // A wrapper around the native label element. The htmlFor association
      // lives at the call site, so the rule cannot see a matching control.
      "files": ["components/ui/label.tsx"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    }
  ]
}
